# =============================================================================
# Offline LLM backend configuration
# Copy to api/.env and edit as needed. Every value below is optional; the
# defaults shown are what the backend uses when the variable is unset.
# =============================================================================

# --- External llama.cpp server (optional) -----------------------------------
# Used only when the backend is NOT managing a llama-server process. If you
# load a model through the Models page, the managed instance takes priority.
LLAMA_BASE_URL=http://127.0.0.1:8080

# --- Storage ----------------------------------------------------------------
# Directory where downloaded and registered GGUF files live.
# MODELS_DIR=/absolute/path/to/models

# Directory for managed llama-server stdout/stderr logs.
# MODEL_LOG_DIR=/absolute/path/to/logs

# SQLAlchemy database URL. Defaults to api/database.sqlite.
# DATABASE_URL=sqlite:////absolute/path/to/database.sqlite

# --- Managed llama-server ---------------------------------------------------
# Binary used to launch managed instances (must be on PATH or absolute).
# LLAMA_SERVER_BIN=llama-server

# Port range the backend scans for a free port when loading a model.
# MODEL_PORT_START=8081
# MODEL_PORT_END=8181

# Seconds to wait for /health before declaring startup a failure.
# MODEL_LOAD_TIMEOUT=180

# Seconds to wait for graceful shutdown before sending SIGKILL.
# MODEL_STOP_TIMEOUT=15

# --- Model defaults ---------------------------------------------------------
# Context window used when a model does not specify one.
# DEFAULT_MODEL_CONTEXT=4096

# Upper bound accepted by the API for a model's context window.
# MAX_MODEL_CONTEXT=131072

# Optional llama-server tuning. Leave unset to use llama.cpp defaults.
# MODEL_GPU_LAYERS=0
# MODEL_THREADS=4

# Reasoning/thinking mode for models that support it: on | off | auto.
# "off" keeps chat replies short and predictable.
# MODEL_REASONING=off

# --- Hugging Face downloads -------------------------------------------------
# Mirror or endpoint used for downloads.
# HF_ENDPOINT=https://huggingface.co

# Streaming download chunk size in bytes and per-read timeout in seconds.
# DOWNLOAD_CHUNK_SIZE=1048576
# DOWNLOAD_TIMEOUT=60
